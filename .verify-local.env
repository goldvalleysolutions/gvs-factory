# Repo-level verify-local.sh settings for gvs-factory
# This is a docs-only / templates-only repo with no application runtime or browser UI.

# Browser e2e is N/A for this repo (no application runtime to test).
# Security scans (gitleaks, semgrep) must still pass.
# See docs/process.md and standards/definition-of-done.md for the narrow applicability rule.
VERIFY_E2E_CMD="echo 'browser e2e: N/A (no application runtime - docs-only repo)' && exit 0"
